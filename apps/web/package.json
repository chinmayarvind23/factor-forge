{
  "name": "factorforge-web",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "test": "bun test src",
    "lint": "biome check .",
    "check": "next typegen && tsc --noEmit && biome check .",
    "dev": "next dev --webpack --hostname 127.0.0.1 --port 3001",
    "start": "next start --hostname 127.0.0.1 --port 3001",
    "e2e": "playwright test --config e2e/playwright.config.ts"
  },
  "dependencies": {
    "next": "^16.3.4",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "@playwright/test": "^1.63.0",
    "@types/bun": "^1.3.10",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "typescript": "^5.9.0"
  }
}
